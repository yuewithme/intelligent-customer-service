APP_ENV=dev
APP_NAME=wechat_rag_bot
API_AUTH_ENABLED=true
API_KEY=change_me

# Memory 2.0 remains write-disabled until its shadow rollout work package.
MEMORY_V2_WRITE_ENABLED=false
MEMORY_V2_LLM_EXTRACTION_ENABLED=true
MEMORY_V2_MIN_CONFIDENCE=0.85
MEMORY_V2_WORKER_POLL_SECONDS=1.0
MEMORY_V2_JOB_LEASE_SECONDS=600
MEMORY_V2_JOB_MAX_ATTEMPTS=3
MEMORY_V2_JOB_RETRY_BASE_SECONDS=30
QDRANT_MEMORY_COLLECTION=customer_memory
MEMORY_V2_RETRIEVAL_TOP_K=20
MEMORY_V2_CONTEXT_MAX_FACTS=8
MEMORY_V2_CONTEXT_MAX_EPISODES=2
MEMORY_V2_CONTEXT_MAX_EVIDENCE_PER_EPISODE=4
MEMORY_V2_SHADOW_ENABLED=false
MEMORY_V2_CANARY_ENABLED=false
MEMORY_V2_CANARY_PERCENT=0
MEMORY_V2_GATE_BYPASS_ENABLED=false
MEMORY_V2_SHADOW_MIN_SAMPLES=100

WECHAT_TOKEN=change_me
WECHAT_APP_ID=change_me
WECHAT_APP_SECRET=change_me
WECHAT_DEFAULT_KB_ID=kb_default

# Eyun personal WeChat API smoke test.
# EYUN_BASE_URL is the API domain shown in Eyun console.
EYUN_BASE_URL=
EYUN_ACCOUNT=
EYUN_PASSWORD=
EYUN_AUTHORIZATION=
EYUN_WID=
EYUN_WCID=
# The public URL that Eyun can download when it sends the fixed opening image.
EYUN_OPENING_IMAGE_URL=https://your-public-domain/static/xiaolanyuan-opening.jpg
EYUN_OPENING_MATERIAL_ID=
EYUN_MATERIAL_GROUP_WC_ID=
EYUN_CONTACT_REFRESH_DELAY_SECONDS=15
# All production WeChat sends share this per-wId queue. 30/min with a safety margin.
EYUN_SEND_MAX_PER_MINUTE=30
EYUN_SEND_MIN_INTERVAL_SECONDS=2.1
EYUN_SEND_MAX_INTERVAL_SECONDS=3.0

# Youzan read-only product/order queries. Confirm API versions and page paths in
# the authorized Youzan app and store console before enabling in production.
YOUZAN_ENABLED=false
YOUZAN_BASE_URL=https://open.youzanyun.com
YOUZAN_ACCESS_TOKEN=
YOUZAN_KDT_ID=
YOUZAN_PRODUCT_SEARCH_METHOD=youzan.items.onsale.get
YOUZAN_PRODUCT_SEARCH_VERSION=3.0.0
YOUZAN_ORDER_SEARCH_METHOD=youzan.trades.sold.get
YOUZAN_ORDER_SEARCH_VERSION=4.0.0
YOUZAN_CUSTOMER_GET_METHOD=youzan.scrm.customer.get
YOUZAN_CUSTOMER_GET_VERSION=3.0.0
YOUZAN_PRODUCT_DETAIL_ENABLED=true
YOUZAN_PRODUCT_DETAIL_METHOD=youzan.item.get
YOUZAN_PRODUCT_DETAIL_VERSION=3.0.0
YOUZAN_INVENTORY_METHOD=youzan.items.inventory.get
YOUZAN_INVENTORY_VERSION=3.0.0
YOUZAN_PRODUCT_SYNC_ENABLED=true
YOUZAN_PRODUCT_SYNC_INTERVAL_HOURS=24
YOUZAN_PRODUCT_SYNC_STARTUP_DELAY_SECONDS=30
YOUZAN_PRODUCT_SYNC_PAGE_SIZE=100
YOUZAN_PRODUCT_SYNC_DETAIL_CONCURRENCY=5
YOUZAN_FOLLOWER_GET_METHOD=youzan.users.weixin.follower.get
YOUZAN_FOLLOWER_GET_VERSION=3.0.0
YOUZAN_ORDER_DETAIL_ENABLED=true
YOUZAN_ORDER_DETAIL_METHOD=youzan.trade.get
YOUZAN_ORDER_DETAIL_VERSION=4.0.0
# Enable only after the Youzan app has logistics-query permission.
YOUZAN_LOGISTICS_ENABLED=false
YOUZAN_LOGISTICS_METHOD=youzan.logistics.expressbyorderno.search
YOUZAN_LOGISTICS_VERSION=3.0.0
# Enable after the callback URL and credentials are configured in Youzan Cloud.
YOUZAN_CALLBACK_ENABLED=false
YOUZAN_CLIENT_ID=
YOUZAN_CLIENT_SECRET=
# Copy the real promoted product path from Youzan. Supported placeholders:
# {alias}, {item_id}, {kdt_id}
YOUZAN_PRODUCT_PAGE_PATH_TEMPLATE=
YOUZAN_PRODUCT_H5_URL_TEMPLATE=
YOUZAN_MINI_PROGRAM_APP_ID=
YOUZAN_MINI_PROGRAM_USER_NAME=
YOUZAN_MINI_PROGRAM_DISPLAY_NAME=
YOUZAN_MINI_PROGRAM_ICON_URL=
YOUZAN_ORDER_PAGE_PATH=
YOUZAN_ORDER_CARD_TITLE=查看我的订单
YOUZAN_ORDER_CARD_THUMB_URL=

QDRANT_URL=https://your-qdrant-url
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION=knowledge_chunks
QDRANT_KNOWLEDGE_COLLECTION=knowledge_chunks
QDRANT_TEMPLATE_COLLECTION=reply_templates
QDRANT_INTENT_COLLECTION=intent_examples
QDRANT_VECTOR_SIZE=1024
QDRANT_DISTANCE=COSINE
QDRANT_TRUST_ENV=true
QDRANT_UPSERT_BATCH_SIZE=128

LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=180
RAG_LLM_PROVIDER=
RAG_LLM_MODEL=
INTENT_LLM_PROVIDER=
INTENT_LLM_MODEL=
INTENT_PROVIDER=rule
INTENT_LLM_ENABLED=true
TALK_SCRIPT_LLM_PROVIDER=
TALK_SCRIPT_LLM_MODEL=
PERSONA_LLM_PROVIDER=
PERSONA_LLM_MODEL=
PERSONA_REPLY_ENABLED=true
PERSONA_REPLY_TEMPERATURE=0.3
REVIEW_LLM_PROVIDER=
REVIEW_LLM_MODEL=
INTENT_CONFIDENCE_THRESHOLD=0.6
INTENT_LLM_FALLBACK_THRESHOLD=0.5
INTENT_EXAMPLE_TOP_K=5
DEEPSEEK_API_KEY=your-deepseek-key
VOLCENGINE_API_KEY=your-volcengine-key
ARK_API_KEY=your-ark-key
OPENAI_API_KEY=your-openai-key
DASHSCOPE_API_KEY=your-dashscope-key

EMBEDDING_PROVIDER=bge
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_BATCH_SIZE=16

RAG_TOP_K=20
RAG_TOP_N=5
RAG_KNOWLEDGE_ENABLED=false
TEMPLATE_TOP_K=5
TEMPLATE_MIN_SCORE=0.5
STATE_PROVIDER=memory
RULE_GUARD_ENABLED=true
DEBUG_API_ENABLED=true
CHUNK_SIZE=600
CHUNK_OVERLAP=100
CHUNK_STRATEGY=fixed
MARKDOWN_HEADING_MAX_LEVEL=6

DATABASE_URL=sqlite:///./rag.db
REDIS_URL=redis://localhost:6379/0
UPLOAD_DIR=data/uploads

CHAT_LOG_ENABLED=true
INTENT_OBSERVATION_ENABLED=true
INTENT_TRAINING_EXPORT_MAX_ROWS=10000
CHAT_LOG_PROVIDER=sqlite
CHAT_LOG_DB_URL=sqlite:///./chat_logs.db
CHAT_LOG_RETENTION_DAYS=30
CHAT_LOG_MAX_MESSAGE_LENGTH=2000
CHAT_LOG_MAX_ANSWER_LENGTH=4000
