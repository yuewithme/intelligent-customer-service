APP_ENV=prod
APP_NAME=intelligent_customer_service

API_AUTH_ENABLED=true
API_KEY=replace_with_a_long_random_key
MCP_API_KEY=replace_with_a_separate_mcp_key

WECHAT_TOKEN=replace_me
WECHAT_APP_ID=replace_me
WECHAT_APP_SECRET=replace_me
WECHAT_DEFAULT_KB_ID=kb_default

EYUN_BASE_URL=http://www.eyunz.com/wx-api
EYUN_AUTHORIZATION=replace_me
EYUN_WID=replace_me
EYUN_CONTACT_REFRESH_DELAY_SECONDS=15

QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=knowledge_chunks
QDRANT_KNOWLEDGE_COLLECTION=knowledge_chunks
QDRANT_TEMPLATE_COLLECTION=reply_templates
QDRANT_INTENT_COLLECTION=intent_examples
QDRANT_VECTOR_SIZE=1024
QDRANT_DISTANCE=COSINE
QDRANT_TRUST_ENV=true
QDRANT_UPSERT_BATCH_SIZE=128

LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
PROFILE_LLM_PROVIDER=
PROFILE_LLM_MODEL=
PROFILE_ANALYSIS_PROMPT=
INTENT_PROVIDER=rule
INTENT_LLM_ENABLED=false
DEEPSEEK_API_KEY=replace_me
VOLCENGINE_API_KEY=
ARK_API_KEY=
OPENAI_API_KEY=
DASHSCOPE_API_KEY=

EMBEDDING_PROVIDER=bge
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_BATCH_SIZE=16

RAG_TOP_K=20
RAG_TOP_N=5
RAG_KNOWLEDGE_ENABLED=false
TEMPLATE_TOP_K=5
TEMPLATE_MIN_SCORE=0.5
STATE_PROVIDER=memory
RULE_GUARD_ENABLED=true
DEBUG_API_ENABLED=false
UPLOAD_DIR=/app/data/uploads

DATABASE_URL=sqlite:////app/data/rag.db
CHAT_LOG_ENABLED=true
CHAT_LOG_PROVIDER=sqlite
CHAT_LOG_DB_URL=sqlite:////app/data/chat_logs.db
CHAT_LOG_RETENTION_DAYS=30
CHAT_LOG_MAX_MESSAGE_LENGTH=2000
CHAT_LOG_MAX_ANSWER_LENGTH=4000
