# 图片理解（云端调用，无需 GPU）
VISION_ENABLED=true
VISION_MODEL=qwen3.7-plus
VISION_OCR_ENABLED=true
VISION_OCR_MODEL=qwen3.5-ocr
VISION_API_KEY=replace_me
