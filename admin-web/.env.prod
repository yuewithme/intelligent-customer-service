# 生产环境：只在打包时使用
NODE_ENV=production

VITE_DEV=false

# 请求路径，生产由 Nginx 同域反代到后端
VITE_BASE_URL=

# 文件上传类型：server - 后端上传， client - 前端直连上传，仅支持S3服务
VITE_UPLOAD_TYPE=server

# 接口地址，后端本身已经带 /api/v1 前缀
VITE_API_URL=
VITE_DEFAULT_API_KEY=vercel-proxy
VITE_GATE_ENABLED=true

# 是否删除debugger
VITE_DROP_DEBUGGER=true

# 是否删除console.log
VITE_DROP_CONSOLE=true

# 是否sourcemap
VITE_SOURCEMAP=false

# 是否开启压缩，可以设置为 none, gzip, brotli, gzip,brotli
VITE_COMPRESS=none

# 打包路径
VITE_BASE_PATH=/

# 输出路径
VITE_OUT_DIR=dist-prod

